// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum PlayerType {
  Skater
  Goalie
}

model Team {
  id           String   @default(uuid())
  name         String
  shortName    String
  abbreviation String   @id @unique
  createdAt    DateTime @default(now())

  players Player[] // 👈 relation field

  @@index([abbreviation])
}

model Player {
  id          String     @default(uuid())
  nhlId       Int        @id @unique
  fullName    String
  firstName   String
  lastName    String
  nationality String
  playerType  PlayerType
  createdAt   DateTime   @default(now())

  teamId String // 👈 foreign key
  team   Team   @relation(fields: [teamId], references: [abbreviation])

  @@index([nhlId])
  @@index([teamId])
}
